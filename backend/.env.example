# GreenWave Backend Environment Configuration
PROJECT_NAME="GreenWave API"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key"

# Database connection:
# On Vercel, attach a Vercel Postgres / Neon database.
# POSTGRES_URL, DATABASE_URL, or SQLALCHEMY_DATABASE_URI will be automatically utilized.
# Example: postgresql+psycopg://user:password@host:5432/greenwave?sslmode=require
POSTGRES_URL=""
DATABASE_URL=""
SQLALCHEMY_DATABASE_URI=""

# External Traffic Provider (optional, e.g. TomTom)
TRAFFIC_PROVIDER="tomtom"
TRAFFIC_API_KEY=""

# Traffic Simulation Engine
SIMULATION_ENGINE="fallback"
