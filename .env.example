# ==============================================================================
# GreenWave — Vercel Multi-Service Project Environment Variables
# ==============================================================================

# Backend Service Variables (Scope: backend)
PROJECT_NAME="GreenWave API"
API_V1_STR="/api/v1"
SECRET_KEY="generate-a-strong-random-secret-key"

# Database Configuration (Scope: backend)
# In Vercel, link a Vercel Postgres / Neon storage database.
# POSTGRES_URL or SQLALCHEMY_DATABASE_URI are automatically recognized.
# Format: postgresql+psycopg://username:password@hostname:5432/database_name
POSTGRES_URL=""
SQLALCHEMY_DATABASE_URI=""

# Optional External API Keys (Scope: backend)
TRAFFIC_PROVIDER="tomtom"
TRAFFIC_API_KEY=""
SIMULATION_ENGINE="fallback"

# Frontend Service Variables (Scope: frontend)
# Default is '/api/v1' for same-origin routing through Vercel rewrites.
VITE_API_BASE_URL="/api/v1"
